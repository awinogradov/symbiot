{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/symbiot\" prepare",
            "timeout": 120,
            "statusMessage": "Symbiot: preparing plan reviewer (first run downloads the viewer)…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/symbiot\" run-hook",
            "timeout": 3600,
            "statusMessage": "Symbiot: opening plan reviewer…"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/symbiot\" run-hook",
            "timeout": 3600,
            "statusMessage": "Symbiot: confirming plan approval…"
          }
        ]
      }
    ]
  }
}
