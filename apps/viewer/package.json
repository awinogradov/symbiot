{
  "name": "@symbiot/viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server/startServer.ts",
  "exports": {
    ".": "./src/server/startServer.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun build src/bin.ts --target=bun --outfile dist/bin.js",
    "start": "bun src/bin.ts",
    "start:prod": "bun dist/bin.js",
    "smoke": "bun src/bin.ts --plan ../../fixtures/plans/elements.md",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@symbiot/annotations": "workspace:*",
    "@symbiot/editor": "workspace:*",
    "@symbiot/ui": "workspace:*",
    "lucide-react": "1.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@symbiot/eslint-config": "workspace:*",
    "@symbiot/tailwind-config": "workspace:*",
    "@symbiot/typescript-config": "workspace:*",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.3.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.6"
  }
}
