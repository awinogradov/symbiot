{
  "name": "@symbiot/opencode-plugin",
  "version": "0.3.0",
  "description": "OpenCode plugin for symbiot — interactive plan review in a browser viewer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awinogradov/symbiot.git",
    "directory": "apps/opencode-plugin"
  },
  "type": "module",
  "main": "dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/plugin.ts --target=bun --outdir dist",
    "install-plugin": "bun src/cli.ts install",
    "uninstall-plugin": "bun src/cli.ts uninstall",
    "annotate": "bun src/cli.ts annotate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.15.13",
    "@opencode-ai/sdk": "1.15.13",
    "@symbiot/agent-runtime": "workspace:*",
    "@symbiot/eslint-config": "workspace:*",
    "@symbiot/typescript-config": "workspace:*",
    "@symbiot/viewer": "workspace:*",
    "@types/bun": "1.3.14",
    "eslint": "10.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "zod": "4.4.3"
  }
}
