{
  "name": "@symbiot/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "build": "echo 'no build yet'",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/code-block": "53.0.0",
    "@platejs/comment": "53.0.0",
    "@platejs/list": "53.0.2",
    "@platejs/markdown": "53.0.4",
    "@platejs/media": "53.0.1",
    "@platejs/suggestion": "53.0.0",
    "@platejs/table": "53.0.0",
    "@symbiot/annotations": "workspace:*",
    "@symbiot/ui": "workspace:*",
    "platejs": "53.0.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "1.29.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@symbiot/eslint-config": "workspace:*",
    "@symbiot/typescript-config": "workspace:*",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
