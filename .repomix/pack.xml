/*
 * Animated icons (`@symbiot/ui` CheckIcon / SendIcon) replay a draw-in / lift
 * animation on hover. Lives in the shared theme — not a consuming app's CSS —
 * so every `@symbiot/ui` consumer that imports this theme gets the animation;
 * the components ship only stable class names, no app-local style dependency.
 * The trigger is the closest interactive ancestor (`[data-slot="button"]`,
 * whose hit area is larger than the glyph) OR the icon itself when standalone
 * (`.symbiot-icon:hover`). `transform-box: fill-box` scopes SVG transform
 * origins to each shape's own box; paths set `pathLength="1"` so dash units are
 * normalized. Replaces the former Framer Motion dependency.
 */
.symbiot-check-path {
  stroke-dasharray: 1;
  stroke-dashoffset: 0;
  transform-box: fill-box;
  transform-origin: center;
}
@media (hover: hover) {
  [data-slot="button"]:hover .symbiot-check-path,
  .symbiot-icon:hover .symbiot-check-path {
    animation: symbiot-draw-check 0.4s ease;
  }
}
@keyframes symbiot-draw-check {
  0% {
    stroke-dashoffset: 1;
    opacity: 0;
    transform: scale(0.5);
  }
  100% {
    stroke-dashoffset: 0;
    opacity: 1;
    transform: scale(1);
  }
}

.symbiot-send-plane {
  transform-box: fill-box;
  transform-origin: center;
  transition: transform 0.2s ease-out;
}
@media (hover: hover) {
  [data-slot="button"]:hover .symbiot-send-plane,
  .symbiot-icon:hover .symbiot-send-plane {
    transform: translate(3px, -3px) scale(0.8);
  }
}
.symbiot-send-trail {
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  opacity: 0;
  transition:
    stroke-dashoffset 0.55s ease 0.1s,
    opacity 0.3s ease;
}
@media (hover: hover) {
  [data-slot="button"]:hover .symbiot-send-trail,
  .symbiot-icon:hover .symbiot-send-trail {
    stroke-dashoffset: 0;
    opacity: 1;
  }
}

/*
 * Accessibility — honor the OS "reduce motion" setting (WCAG 2.1 §2.3.3).
 * Per the reduced-motion guidance, keep opacity/colour transitions that aid
 * comprehension and drop motion that moves or scales elements. The shared
 * `tw-animate-css` enter/exit keyframes compose movement from the transform
 * vars below and fade from `--tw-*-opacity`; neutralising the transform/blur
 * vars leaves the fades intact, so overlays still cross-fade in and out — they
 * just don't fly, zoom, or spin. The decorative icon hovers are pure movement,
 * so they're switched off entirely.
 */
@media (prefers-reduced-motion: reduce) {
  *,
  ::before,
  ::after {
    --tw-enter-translate-x: 0 !important;
    --tw-enter-translate-y: 0 !important;
    --tw-exit-translate-x: 0 !important;
    --tw-exit-translate-y: 0 !important;
    --tw-enter-scale: 1 !important;
    --tw-exit-scale: 1 !important;
    --tw-enter-rotate: 0 !important;
    --tw-exit-rotate: 0 !important;
    --tw-enter-blur: 0 !important;
    --tw-exit-blur: 0 !important;
  }

  .symbiot-check-path,
  .symbiot-send-plane,
  .symbiot-send-trail {
    animation: none !important;
    transition: none !important;
  }
}
</file>

