<file path="apps/claude-code/bin/symbiot">
#!/usr/bin/env sh
# symbiot shim: ensure the platform binary is cached under
# ${CLAUDE_PLUGIN_DATA}/bin, then exec it. Called from hooks.json under three
# subcommands:
#   prepare   → SessionStart  (ensure cached; no exec)
#   run-hook  → ExitPlanMode  (ensure cached; exec binary run-hook)
#   <other>   → manual CLI    (ensure cached; exec binary with args)
#
# Concurrency: a cold cache can have SessionStart `prepare` and an ExitPlanMode
# `run-hook` download at the same time. They coordinate through a portable
# mkdir lock — the loser waits for the winner's download instead of starting
# its own. (The previous flock guard was a silent no-op on macOS, whose default
# shell has no flock, so both sides raced and clobbered a shared temp file.)
set -e

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA_DIR="${CLAUDE_PLUGIN_DATA:-$HOME/.symbiot/plugin-data}"

# Durable shim-side log. The compiled binary writes events.log only AFTER it is
# exec'd, so pre-exec failures (download, lock, verify) would otherwise leave no
# trace. shim_log is best-effort and never fails the script under `set -e`.
SHIM_LOG="${HOME:-/tmp}/.symbiot/hook-state/shim.log"
shim_log() {
  mkdir -p "${SHIM_LOG%/*}" 2>/dev/null || true
  printf '%s pid=%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$$" "$1" >> "$SHIM_LOG" 2>/dev/null || true
}

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)    TRIPLE="darwin-arm64" ;;
  Darwin-x86_64)   TRIPLE="darwin-x64"   ;;
  Linux-x86_64)    TRIPLE="linux-x64"    ;;
  *)
    echo "symbiot: unsupported platform $(uname -s)-$(uname -m)" >&2
    exit 1
    ;;
esac

BIN="$DATA_DIR/bin/symbiot-$TRIPLE"
EXPECTED="$(awk -v t="symbiot-$TRIPLE" '$2 == t { print $1 }' "$PLUGIN_ROOT/bin/SHA256SUMS" 2>/dev/null || true)"

if [ -z "$EXPECTED" ]; then
  echo "symbiot: no SHA256 for symbiot-$TRIPLE in $PLUGIN_ROOT/bin/SHA256SUMS" >&2
  exit 1
fi

# True when the cached binary exists and matches the expected hash.
binary_valid() {
  [ -x "$BIN" ] && [ "$(shasum -a 256 "$BIN" 2>/dev/null | awk '{ print $1 }')" = "$EXPECTED" ]
}

# Download, verify, and atomically install the binary. Uses a PID-unique temp
# so concurrent downloaders can never clobber a shared file.
download_binary() {
  VERSION="$(cat "$PLUGIN_ROOT/bin/VERSION")"
  URL="https://github.com/awinogradov/symbiot/releases/download/$VERSION/symbiot-$TRIPLE"
  TMP="$BIN.tmp.$$"
  echo "symbiot: downloading $URL …" >&2
  shim_log "download: start $URL"
  rc=0
  curl -fsSL "$URL" -o "$TMP" || rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$TMP"
    shim_log "download: curl failed rc=$rc url=$URL"
    echo "symbiot: download failed (curl rc=$rc)" >&2
    exit 1
  fi
  ACTUAL="$(shasum -a 256 "$TMP" | awk '{ print $1 }')"
  if [ "$EXPECTED" != "$ACTUAL" ]; then
    rm -f "$TMP"
    shim_log "download: sha256 mismatch expected=$EXPECTED got=$ACTUAL"
    echo "symbiot: sha256 mismatch (expected $EXPECTED, got $ACTUAL)" >&2
    exit 1
  fi
  chmod +x "$TMP"
  mv "$TMP" "$BIN"
  shim_log "download: installed $BIN"
}

# Hold the lock for the duration of a download, then release it.
hold_and_download() {
  I_HOLD_LOCK=1
  echo "$$" > "$LOCKDIR/pid"
  binary_valid || download_binary
  rm -rf "$LOCKDIR"
  I_HOLD_LOCK=""
}

# Cache-hit fast path — no lock needed.
if binary_valid; then
  if [ "$1" = "prepare" ]; then exit 0; fi
  exec "$BIN" "$@"
fi

mkdir -p "$DATA_DIR/bin"
LOCKDIR="$DATA_DIR/bin/.download.lock"
I_HOLD_LOCK=""
TMP=""
# Only the holder removes the lock dir; a waiter must never delete it. The trap
# also clears this process's partial download on interrupt.
trap '[ -n "$I_HOLD_LOCK" ] && rm -rf "$LOCKDIR" 2>/dev/null; [ -n "$TMP" ] && rm -f "$TMP" 2>/dev/null; true' EXIT INT TERM

# A pre-0.3.0 shim created .download.lock as a regular FILE (fd-redirect lock).
# The mkdir lock below can never acquire over a non-directory and would wedge
# every upgrade, so reap any non-directory squatting the path first.
if [ -e "$LOCKDIR" ] && [ ! -d "$LOCKDIR" ]; then
  rm -f "$LOCKDIR"
  shim_log "lock: reaped non-directory .download.lock"
fi

if mkdir "$LOCKDIR" 2>/dev/null; then
  hold_and_download
else
  # Another process is downloading. SessionStart `prepare` is best-effort and
  # time-boxed (120s), so it must not block on the holder — run-hook (3600s)
  # owns the reliable download.
  if [ "$1" = "prepare" ]; then exit 0; fi
  echo "symbiot: waiting for in-progress download …" >&2
  shim_log "lock: waiting for in-progress download"
  waited=0
  while ! binary_valid; do
    if [ "$waited" -ge 300 ]; then
      download_binary
      break
    fi
    HOLDER="$(cat "$LOCKDIR/pid" 2>/dev/null || true)"
    if [ -n "$HOLDER" ] && ! kill -0 "$HOLDER" 2>/dev/null; then
      # Holder died without cleaning up — steal the lock and download.
      rm -rf "$LOCKDIR"
      if mkdir "$LOCKDIR" 2>/dev/null; then hold_and_download; fi
      break
    fi
    sleep 1
    waited=$((waited + 1))
  done
fi

if [ "$1" = "prepare" ]; then exit 0; fi
shim_log "exec $BIN $*"
exec "$BIN" "$@"
</file>

<file path="apps/claude-code/bin/symbiot.cmd">
@echo off
REM symbiot shim (Windows): mirror of bin/symbiot for cmd.exe / PowerShell.
REM Subcommands: prepare | run-hook | <other> — see bin/symbiot for the contract.
REM
REM Concurrency: a portable `md` lock lets a second invocation wait for an
REM in-progress download instead of racing it (mirrors the POSIX mkdir lock).
REM Downloads go to a unique temp so two downloaders never clobber one file.
REM Batch has no trap/`kill -0`, so a holder killed mid-download leaves a stale
REM lock; waiters recover via the bounded-wait self-download fallback below.

setlocal EnableExtensions EnableDelayedExpansion

set "PLUGIN_ROOT=%~dp0.."
if "%CLAUDE_PLUGIN_DATA%"=="" (
  set "DATA_DIR=%USERPROFILE%\.symbiot\plugin-data"
) else (
  set "DATA_DIR=%CLAUDE_PLUGIN_DATA%"
)

REM Only one Windows triple is supported for now.
if /I not "%PROCESSOR_ARCHITECTURE%"=="AMD64" (
  echo symbiot: unsupported platform %PROCESSOR_ARCHITECTURE% 1>&2
  exit /b 1
)
set "TRIPLE=windows-x64"
set "BIN=%DATA_DIR%\bin\symbiot-%TRIPLE%.exe"
set "LOCKDIR=%DATA_DIR%\bin\.download.lock"

set "EXPECTED="
for /f "tokens=1,2" %%a in (%PLUGIN_ROOT%\bin\SHA256SUMS) do (
  if "%%b"=="symbiot-%TRIPLE%.exe" set "EXPECTED=%%a"
)
if "%EXPECTED%"=="" (
  echo symbiot: no SHA256 for symbiot-%TRIPLE%.exe in SHA256SUMS 1>&2
  exit /b 1
)

REM Cache-hit fast path.
call :binary_valid
if %errorlevel%==0 goto :run

if not exist "%DATA_DIR%\bin" mkdir "%DATA_DIR%\bin"

REM A pre-0.3.0 shim may have left .download.lock as a regular file; `md` can
REM never acquire over a non-directory, so remove any squatting the path first.
if exist "%LOCKDIR%" if not exist "%LOCKDIR%\" del /q "%LOCKDIR%" 2>nul

REM Try to acquire the lock; if held, wait for the in-progress download.
md "%LOCKDIR%" 2>nul
if %errorlevel%==0 (
  call :binary_valid
  if !errorlevel! neq 0 call :download_binary
  rd /s /q "%LOCKDIR%" 2>nul
  goto :verify_and_run
)

REM SessionStart `prepare` is best-effort and time-boxed; don't block on the
REM holder — run-hook owns the reliable download.
if "%~1"=="prepare" exit /b 0
echo symbiot: waiting for in-progress download ... 1>&2
set /a waited=0
:waitloop
call :binary_valid
if %errorlevel%==0 goto :run
if !waited! GEQ 300 (
  call :download_binary
  goto :verify_and_run
)
timeout /t 1 /nobreak >nul
set /a waited+=1
goto :waitloop

:verify_and_run
call :binary_valid
if %errorlevel% neq 0 (
  echo symbiot: binary unavailable after download 1>&2
  exit /b 1
)

:run
if "%~1"=="prepare" exit /b 0
"%BIN%" %*
exit /b %errorlevel%

REM ── subroutines ──────────────────────────────────────────────────────────

REM Returns errorlevel 0 when the cached binary matches EXPECTED, else 1.
:binary_valid
if not exist "%BIN%" exit /b 1
set "ACTUAL="
for /f "tokens=*" %%h in ('certutil -hashfile "%BIN%" SHA256 ^| findstr /v ":"') do set "ACTUAL=%%h"
set "ACTUAL=!ACTUAL: =!"
if /I "!ACTUAL!"=="%EXPECTED%" exit /b 0
exit /b 1

REM Download, verify, and atomically install the binary via a unique temp file.
:download_binary
set /p VERSION=<"%PLUGIN_ROOT%\bin\VERSION"
set "URL=https://github.com/awinogradov/symbiot/releases/download/!VERSION!/symbiot-%TRIPLE%.exe"
set "TMP=%BIN%.tmp.%RANDOM%%RANDOM%"
echo symbiot: downloading !URL! ... 1>&2
curl.exe -fsSL "!URL!" -o "!TMP!"
if errorlevel 1 (
  echo symbiot: download failed 1>&2
  del /q "!TMP!" 2>nul
  exit /b 1
)
set "ACTUAL="
for /f "tokens=*" %%h in ('certutil -hashfile "!TMP!" SHA256 ^| findstr /v ":"') do set "ACTUAL=%%h"
set "ACTUAL=!ACTUAL: =!"
if /I not "!ACTUAL!"=="%EXPECTED%" (
  echo symbiot: sha256 mismatch ^(expected %EXPECTED%, got !ACTUAL!^) 1>&2
  del /q "!TMP!" 2>nul
  exit /b 1
)
move /y "!TMP!" "%BIN%" >nul
exit /b 0
</file>

