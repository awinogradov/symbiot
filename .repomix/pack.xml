<file path=".github/workflows/perf.yml">
name: Perf

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

# PR runs are cancelled by newer pushes to the same branch. Main runs are
# never cancelled — every commit on main must produce its own baseline
# snapshot, otherwise downstream PRs lose comparison points.
concurrency:
  # PR runs are keyed by PR number (unique across forks) so fork PRs cannot
  # collide with same-named branches in other repos. Main runs are keyed by
  # commit SHA so each main commit produces its own baseline run.
  group: >-
    ${{
      github.event_name == 'pull_request'
        && format('perf-pr-{0}', github.event.pull_request.number)
        || format('perf-main-{0}', github.sha)
    }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read
  pull-requests: write
  # gh run download / gh run list in the baseline-fetch step needs read
  # access to prior workflow runs and their artifacts.
  actions: read

jobs:
  perf:
    name: Report
    runs-on: ubuntu-latest
    timeout-minutes: 25
    env:
      CI: "true"
      HUSKY: "0"
      # Required by the gh CLI in Actions; the default GITHUB_TOKEN is sufficient
      # for gh run list / gh run download against this repository.
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version-file: package.json

      # Cache key intentionally matches .github/workflows/pr.yml so both
      # workflows share entries instead of evicting each other.
      - name: Restore Turborepo + Bun cache
        uses: actions/cache@v4
        with:
          path: |
            .turbo
            ~/.bun/install/cache
          key: ${{ runner.os }}-turbo-${{ hashFiles('bun.lock', 'turbo.json', '**/package.json') }}
          restore-keys: |
            ${{ runner.os }}-turbo-

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Build viewer
        run: bun run --filter @symbiot/viewer build

      # Multi-chunk build (dist/client) + treemap — this is what Lighthouse
      # serves and measures (the real served experience).
      - name: Bundle analyze
        run: bun run --filter @symbiot/viewer bundle-analyze

      # Single-file embed build (dist/embed/index.html) — the self-contained
      # blob agent binaries ship. The bundle-size metric tracks this so the
      # number stays comparable to the historical single-file baseline instead
      # of measuring the ~1.4 KiB multi-chunk shell. Empties dist/embed only, so
      # the dist/client output Lighthouse serves is untouched.
      - name: Build embed artifact
        working-directory: apps/viewer
        run: SYMBIOT_SINGLEFILE=1 bunx vite build

      # Lighthouse can flake on shared runners. Continue on error so a bad LH
      # run degrades the comment to "measurement failed" instead of failing
      # the whole workflow.
      - name: Run Lighthouse
        id: lighthouse
        continue-on-error: true
        run: bun run perf

      # head_ref is attacker-controllable on PRs (a fork can name its branch
      # `foo"$(cmd)`). Route ref-derived values through env vars and build
      # meta.json via jq so values are JSON-escaped and never re-evaluated by
      # the shell.
      - name: Snapshot head perf outputs
        env:
          HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          HEAD_REF: ${{ github.head_ref || github.ref_name }}
          HEAD_RUN_ID: ${{ github.run_id }}
          HEAD_RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          LH_OUTCOME: ${{ steps.lighthouse.outcome }}
        run: |
          set -eo pipefail
          mkdir -p perf-snapshot
          cp apps/viewer/dist/embed/index.html perf-snapshot/index.html
          if [ -f apps/viewer/bundle-stats/index.html ]; then
            cp apps/viewer/bundle-stats/index.html perf-snapshot/bundle-stats.html
          fi
          LH_STATUS="failed"
          if [ "$LH_OUTCOME" = "success" ] && [ -f perf-reports/lighthouse-viewer.json ]; then
            cp perf-reports/lighthouse-viewer.json perf-snapshot/lighthouse-viewer.json
            LH_STATUS="success"
          fi
          jq -n \
            --arg sha "$HEAD_SHA" \
            --arg ref "$HEAD_REF" \
            --arg runId "$HEAD_RUN_ID" \
            --arg runUrl "$HEAD_RUN_URL" \
            --arg lhStatus "$LH_STATUS" \
            '{sha: $sha, ref: $ref, runId: $runId, runUrl: $runUrl, lhStatus: $lhStatus}' \
            > perf-snapshot/meta.json

      # Walk back through up to 5 recent successful main runs and pull the first
      # one that still has the artifact (older runs may have expired). Always
      # exit 0 — a missing baseline must not fail the workflow.
      #
      # Fork PR guard: `pull-requests: write` is not granted to fork
      # `pull_request` runs, so anything that posts to the API would fail with
      # 403. Skip the baseline-fetch + comment-generate + sticky-comment steps
      # entirely on fork PRs.
      - name: Find baseline (main)
        if: >-
          github.event_name == 'pull_request' &&
          github.event.pull_request.head.repo.full_name == github.repository
        run: |
          set +e
          mkdir -p perf-baseline
          RUN_IDS=$(gh run list \
            --branch main \
            --workflow perf.yml \
            --status success \
            --limit 5 \
            --json databaseId \
            --jq '.[].databaseId' 2>/dev/null)
          if [ -z "$RUN_IDS" ]; then
            echo "No successful main runs yet — head-only mode."
            exit 0
          fi
          for id in $RUN_IDS; do
            echo "Trying baseline from run $id..."
            if gh run download "$id" --name perf-snapshot-main --dir perf-baseline/ 2>/dev/null; then
              echo "Baseline downloaded from run $id."
              exit 0
            fi
          done
          echo "All recent main runs had no usable artifact — head-only mode."
          rm -rf perf-baseline
          mkdir -p perf-baseline
          exit 0

      # MUST exit 0 — the gate lives in a future issue; do not add
      # --fail-on-regression here.
      - name: Generate comment
        if: >-
          github.event_name == 'pull_request' &&
          github.event.pull_request.head.repo.full_name == github.repository
        run: |
          bun run scripts/perf-report.ts \
            --head perf-snapshot \
            --base perf-baseline \
            > perf-comment.md || true

      # Sticky comment posts once per PR and updates in place on subsequent
      # pushes. Gated to same-repo PRs because fork PRs do not get
      # `pull-requests: write` on the default GITHUB_TOKEN. `continue-on-error`
      # is a belt-and-suspenders safety net for token edge cases.
      - name: Sticky perf comment
        if: >-
          github.event_name == 'pull_request' &&
          github.event.pull_request.head.repo.full_name == github.repository
        continue-on-error: true
        uses: marocchino/sticky-pull-request-comment@v2
        with:
          header: Perf
          path: perf-comment.md

      - name: Upload perf snapshot
        uses: actions/upload-artifact@v4
        with:
          name: >-
            ${{
              github.event_name == 'pull_request'
                && format('perf-snapshot-pr-{0}', github.event.pull_request.number)
                || 'perf-snapshot-main'
            }}
          path: perf-snapshot/
          retention-days: 30
          if-no-files-found: error
</file>

<file path=".github/workflows/pr.yml">
name: PR

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  pr:
    name: Check
    runs-on: ubuntu-latest
    # Chromium full suite + Firefox/WebKit @smoke (cross-browser NFR-6 matrix);
    # the extra engines' cold launch needs headroom over the prior Chromium-only 20.
    timeout-minutes: 30
    permissions:
      contents: read
      pull-requests: write
    env:
      CI: "true"
      HUSKY: "0"
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version-file: package.json

      - name: Restore Turborepo + Bun cache
        uses: actions/cache@v4
        with:
          path: |
            .turbo
            ~/.bun/install/cache
          key: ${{ runner.os }}-turbo-${{ hashFiles('bun.lock', 'turbo.json', '**/package.json') }}
          restore-keys: |
            ${{ runner.os }}-turbo-

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Format check
        run: bun run format:check

      - name: Ban time-based waits in features
        shell: bash
        run: |
          set -euo pipefail
          feature_hits=$(grep -rEn '^\s*(And |Given |When |Then )?I (wait|pause|sleep)( |$)' features/ --include='*.feature' || true)
          ts_hits=$(grep -rEn 'waitForTimeout\(|(^|[^.])setTimeout\(|globalThis\.setTimeout\(' features/ --include='*.ts' || true)
          if [[ -n "$feature_hits" || -n "$ts_hits" ]]; then
            echo "::error::Time-based waits found in features/ (issue #131). Wait on selectors, assertions, or page.waitForFunction. See features/README.md."
            [[ -n "$feature_hits" ]] && echo "$feature_hits"
            [[ -n "$ts_hits" ]] && echo "$ts_hits"
            exit 1
          fi

      - name: Enforce data-testid-only selectors in features
        shell: bash
        run: |
          set -euo pipefail
          getter_hits=$(grep -rPn 'getBy(Role|Text|Label|Placeholder|AltText|Title)\(' features/steps/ --include='*.ts' || true)
          locator_hits=$(grep -rPn '\.locator\(\s*["'\''`](?!\[data-testid)' features/steps/ --include='*.ts' || true)
          # The lookahead above only guards the *leading* token; a selector may
          # still start with [data-testid…] yet embed a framework-internal attr
          # in a descendant (e.g. `[data-testid=…] [data-slate-node=…]` or
          # `[data-testid=…] span[style*=…]`). Ban those attribute selectors too.
          embedded_hits=$(grep -rPn '\[(data-slate-|data-radix-)|style[\^\$\*~]?=' features/steps/ --include='*.ts' || true)
          if [[ -n "$getter_hits" || -n "$locator_hits" || -n "$embedded_hits" ]]; then
            echo "::error::Non-data-testid selectors found in features/steps (issues #141/#132). Use getByTestId or .locator('[data-testid=...]'). See docs/08-testing.md#playwright-bdd-selectors."
            [[ -n "$getter_hits" ]] && echo "$getter_hits"
            [[ -n "$locator_hits" ]] && echo "$locator_hits"
            [[ -n "$embedded_hits" ]] && echo "$embedded_hits"
            exit 1
          fi

      - name: Lint check
        run: bun run lint

      - name: Typecheck
        run: bun run typecheck

      - name: Coverage
        run: bun run coverage

      - name: Coverage PR comment
        if: always() && github.event_name == 'pull_request'
        uses: davelosert/vitest-coverage-report-action@v2
        with:
          name: Unit

      - name: Resolve Playwright version
        id: pw
        run: echo "version=$(bunx playwright --version | sed 's/Version //')" >> "$GITHUB_OUTPUT"

      # Browser binaries live in ~/.cache/ms-playwright, which the Turbo/Bun cache
      # key above does not cover — without this, all three engines re-download on
      # every run. Keyed on the Playwright version so a bump re-primes the cache.
      - name: Cache Playwright browsers
        id: playwright-cache
        uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: ${{ runner.os }}-playwright-${{ steps.pw.outputs.version }}

      - name: Install Playwright browsers
        if: steps.playwright-cache.outputs.cache-hit != 'true'
        run: bunx playwright install --with-deps chromium firefox webkit

      # On a cache hit the binaries are restored but the apt system libs are not
      # cached, so re-add them for all three engines.
      - name: Install Playwright system dependencies
        if: steps.playwright-cache.outputs.cache-hit == 'true'
        run: bunx playwright install-deps chromium firefox webkit

      # Chromium runs the full suite with V8 coverage (the 90% BDD gate); CI=true
      # activates the firefox/webkit projects in playwright.config.ts, which run the
      # @smoke subset only (no coverage — page.coverage is Chromium-only).
      - name: BDD
        run: bun run test:e2e:coverage

      - name: BDD Coverage PR comment
        if: always() && github.event_name == 'pull_request' && hashFiles('coverage/e2e/coverage-summary.json') != ''
        uses: davelosert/vitest-coverage-report-action@v2
        with:
          name: BDD
          json-summary-path: coverage/e2e/coverage-summary.json
          json-final-path: coverage/e2e/coverage-final.json
          vite-config-path: vitest.config.ts
          file-coverage-root-path: ${{ github.workspace }}

      - name: Build
        run: bun run build
</file>

<file path=".github/workflows/release.yml">
name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write
  pull-requests: write

jobs:
  build:
    name: Build ${{ matrix.triple }}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: macos-14
            triple: darwin-arm64
          - os: macos-14
            triple: darwin-x64
          - os: ubuntu-latest
            triple: linux-x64
          - os: windows-latest
            triple: windows-x64
    env:
      CI: "true"
      HUSKY: "0"
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version-file: package.json

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Build viewer (single-file HTML + gzip)
        run: bun --filter @symbiot/viewer build

      - name: Compile binaries (claude-code + codex + gemini + copilot)
        shell: bash
        run: |
          bun --filter @symbiot/claude-code compile:${{ matrix.triple }}
          bun --filter @symbiot/codex compile:${{ matrix.triple }}
          bun --filter @symbiot/gemini compile:${{ matrix.triple }}
          bun --filter @symbiot/copilot compile:${{ matrix.triple }}

      - name: Stage binaries for this platform
        shell: bash
        run: |
          mkdir -p staging
          cp apps/claude-code/dist/bin/symbiot-${{ matrix.triple }}* staging/
          cp apps/codex/dist/bin/symbiot-codex-${{ matrix.triple }}* staging/
          cp apps/gemini/dist/bin/symbiot-gemini-${{ matrix.triple }}* staging/
          cp apps/copilot/dist/bin/symbiot-copilot-${{ matrix.triple }}* staging/

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: binaries-${{ matrix.triple }}
          path: staging/*
          if-no-files-found: error

  release:
    name: Publish release
    runs-on: ubuntu-latest
    needs: build
    timeout-minutes: 10
    env:
      GH_TOKEN: ${{ secrets.GH_TOKEN }}
    steps:
      - uses: actions/checkout@v4

      - name: Download artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts
          merge-multiple: true

      - name: Compute SHA256SUMS
        working-directory: artifacts
        run: shasum -a 256 symbiot-* > SHA256SUMS

      - name: Create GitHub Release
        run: |
          gh release create "${GITHUB_REF_NAME}" \
            --generate-notes \
            artifacts/symbiot-* artifacts/SHA256SUMS

      - name: Open version-bump PR
        run: |
          BR="release-${GITHUB_REF_NAME#v}"
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git checkout -b "$BR"
          # claude-code's shim reads only its own four binaries; keep its in-repo
          # SHA256SUMS limited to those (the release asset carries every agent's hashes).
          awk '$2 ~ /^symbiot-(darwin-arm64|darwin-x64|linux-x64|windows-x64\.exe)$/' \
            artifacts/SHA256SUMS > apps/claude-code/bin/SHA256SUMS
          printf '%s\n' "${GITHUB_REF_NAME}" > apps/claude-code/bin/VERSION
          VER="${GITHUB_REF_NAME#v}"
          # Repo-wide single version: bump the "version" field in every version-bearing manifest so
          # all integrations stay in lockstep with the tag. A JSON parse-and-rewrite reformats em-dashes,
          # inline objects, and arrays, which fails `bun run format:check`, so use a targeted sed on the
          # first "version" key only (in each package.json that is the package version, before deps).
          manifests="apps/claude-code/.claude-plugin/plugin.json apps/gemini/extension/gemini-extension.json apps/claude-code/package.json apps/codex/package.json apps/copilot/package.json apps/gemini/package.json apps/opencode-plugin/package.json apps/viewer/package.json"
          for m in $manifests; do
            sed -i '1,/"version":/ s/"version": "[^"]*"/"version": "'"$VER"'"/' "$m"
            grep -q "\"version\": \"$VER\"" "$m" || { echo "version bump did not land in $m"; exit 1; }
          done
          git add apps/claude-code/bin/SHA256SUMS apps/claude-code/bin/VERSION $manifests
          git commit -m "chore(release): ${GITHUB_REF_NAME}"
          git push -u origin "$BR"
          gh pr create \
            --base main \
            --head "$BR" \
            --title "chore(release): ${GITHUB_REF_NAME}" \
            --body "Auto-generated by .github/workflows/release.yml for tag ${GITHUB_REF_NAME}. Syncs apps/claude-code/bin/SHA256SUMS and bin/VERSION to the new release assets and bumps every integration manifest (claude-code plugin.json, gemini-extension.json, and all apps/* package.json) to ${VER}."

  npm-publish:
    name: Publish @symbiot/opencode-plugin to npm
    runs-on: ubuntu-latest
    needs: build
    timeout-minutes: 10
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          registry-url: "https://registry.npmjs.org"

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version-file: package.json

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Audit dependencies
        run: bun audit

      - name: Build viewer (embedded asset) + opencode plugin bundle
        run: |
          bun --filter @symbiot/viewer build
          bun --filter @symbiot/opencode-plugin build

      - name: Publish (provenance) — dry-run when NPM_TOKEN is absent
        working-directory: apps/opencode-plugin
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
        run: |
          # The tag drives the published version; the in-repo bump PR lands after release.
          npm version "${GITHUB_REF_NAME#v}" --no-git-tag-version --allow-same-version
          # bun pm pack normalizes the workspace:* protocol and honors "files"; runtime deps
          # are bundled into dist/plugin.js, so the tarball has no unresolvable dependencies.
          bun pm pack
          if [ -z "${NODE_AUTH_TOKEN:-}" ]; then
            echo "NPM_TOKEN not set — running publish in --dry-run mode."
            npm publish ./*.tgz --access public --dry-run
          else
            npm publish ./*.tgz --provenance --access public
          fi
</file>

<file path=".github/workflows/repomix-pack.yml">
# Requires repo secret `BOT_TOKEN`: a PAT (classic with `repo`, or fine-grained
# with `contents: write`) or a GitHub App installation token. The default
# `GITHUB_TOKEN` cannot push to a protected branch or trigger downstream
# workflows under our settings — see `upstream.yml` for the same rationale.
#
# The final step pushes directly to `main`, so the `BOT_TOKEN` identity must
# ALSO be a bypass actor on the protected-branch ruleset. `contents: write`
# alone is not enough: when the ruleset requires PRs, a direct push is rejected
# with `GH013` ("Changes must be made through a pull request") regardless of the
# token's write scope. Add the bot to the ruleset's bypass list (Settings →
# Rules → the branch ruleset → Bypass list).
#
# Optional repo variable `BOT_USERNAME`: git author login for the pack commit.
# Defaults to `github-actions[bot]` when unset.

name: Repomix pack

on:
  pull_request:
    types: [closed]
    branches: [main]

concurrency:
  group: repomix-pack-${{ github.workflow }}
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  pack:
    name: Pack codebase snapshot
    if: github.event.pull_request.merged == true
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v6
        with:
          ref: main
          token: ${{ secrets.BOT_TOKEN }}

      - name: Generate pack
        run: npx --yes repomix@1.14.1

      - name: Commit pack if changed
        env:
          BOT_USERNAME: ${{ vars.BOT_USERNAME }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          git add .repomix/pack.xml
          if git diff --cached --quiet -- .repomix/pack.xml; then
            echo "No pack changes — skipping commit."
            exit 0
          fi
          git config user.name "${BOT_USERNAME:-github-actions[bot]}"
          git config user.email "${BOT_USERNAME:-github-actions[bot]}@users.noreply.github.com"
          git commit -m "chore(repomix): refresh pack from #${PR_NUMBER}"
          # main can advance between checkout and push (concurrent merge, the
          # preceding pack commit, or a re-run); rebase onto it and retry.
          for attempt in 1 2 3; do
            if git push origin HEAD:main; then
              exit 0
            fi
            echo "Push rejected — main advanced; rebasing onto latest main (attempt ${attempt}/3)."
            git fetch origin main
            git rebase origin/main
          done
          echo "::error::Failed to push refreshed pack after 3 attempts."
          exit 1
</file>

<file path=".github/workflows/upstream.yml">
# Requires repo secret `BOT_TOKEN`: a PAT (classic with `repo`, or fine-grained
# with `contents: write` + `pull-requests: write`) or a GitHub App installation
# token. The default `GITHUB_TOKEN` is not supported — see the action README
# in `.github/actions/upstream-sync` for the rationale.
# Optional repo variable `BOT_USERNAME`: git author login for sync commits.
# Defaults to `github-actions[bot]` when unset.

name: Upstream

on:
  schedule:
    # Every hour at minute 0 (UTC). Picks up upstream changes within ~1h and
    # opens (or updates) one maintenance PR per enabled sync kind.
    - cron: "0 * * * *"
  workflow_dispatch:

concurrency:
  group: upstream-${{ github.workflow }}
  cancel-in-progress: false

permissions:
  contents: write
  pull-requests: write

jobs:
  sync:
    name: Sync from upstream
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: awinogradov/code-assistants/.github/actions/upstream-sync@main
        with:
          bot_token: ${{ secrets.BOT_TOKEN }}
          bot_username: ${{ vars.BOT_USERNAME }}
          # Kind inputs are string booleans gated `== 'true'` — use literal
          # true/false, never YAML yes/on (those serialize to "yes"/"on" and
          # silently disable the kind).
          # TODO(symbiot#201): enable the release kind once the custom tag-driven
          # release.yml (binary builds) is folded into upstream's
          # release-create/publish/automerge pipeline.
          release: false
</file>

