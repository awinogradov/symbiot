export function getReactConfig(): Linter.Config[] {
  const recommended = eslintReact.configs["recommended-typescript"] as {
    plugins: Record<string, ESLint.Plugin>;
    rules: Linter.RulesRecord;
  };
  return [
    {
      name: "@symbiot/react",
