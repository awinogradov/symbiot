<file path=".github/workflows/auto-label.yml">
# Source: https://github.com/awinogradov/code-assistants/blob/main/.github/workflows/auto-label.yml
# This file is distributed to downstream repositories by an automated sync.
# Edits made downstream are overwritten on the next run.
# To change it, open a pull request against the source file above.

name: Auto label

on:
  pull_request:
    branches: [main]
    types: [opened, synchronize, reopened]
  push:
    branches: [main]

# Per-PR concurrency: concurrent PRs never cancel each other's label sync, and a
# newer sync for the same PR supersedes the older run. The push-prune runs in its
# own (github.ref) group so PR activity never cancels it. A prune may briefly
# overlap a PR sync, but that is self-healing — the next push re-prunes and each
# PR's labels reflect its own diff.
concurrency:
  group: auto-label-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read
  pull-requests: write
  issues: write

jobs:
  auto-label:
    name: Auto label
    # Fork PRs cannot access secrets.BOT_TOKEN (and run with a read-only token); skip them.
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.fork == false
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: awinogradov/code-assistants/.github/actions/auto-label@main
        with:
          # Pass the bot token so label events are attributed to the project bot
          # identity, not github-actions[bot]. BOT_TOKEN is required: an empty
          # value fails the label API calls with HTTP 401 (no fallback).
          token: ${{ secrets.BOT_TOKEN }}
</file>

<file path=".github/workflows/code-review-cost-monitor.yml">
# Source: https://github.com/awinogradov/code-assistants/blob/main/.github/workflows/code-review-cost-monitor.yml
# This file is distributed to downstream repositories by an automated sync.
# Edits made downstream are overwritten on the next run.
# To change it, open a pull request against the source file above.
#
# Repository secrets consumed by this workflow:
#   - `BOT_TOKEN` (required): PAT or GitHub App installation token with
#     `contents: read` + `issues: write`, used to read PR reviews and open or
#     update the cost-report issue under the bot identity.
#   - `ANTHROPIC_CODE_REVIEW` (optional): Anthropic API key for the attribution
#     step. Only consumed when a run is dispatched with `attribution: true`;
#     the scheduled run is fully deterministic and makes no model call.

name: Code review cost monitor

on:
  schedule:
    # Daily, off the hour — top-of-hour crons are routinely delayed or dropped.
    - cron: "17 7 * * *"
  workflow_dispatch:
    inputs:
      lookback_days:
        description: "Days of PR reviews to scrape (months as days, e.g. 90). Empty keeps the action default (30)."
        required: false
        default: ""
      attribution:
        description: "Run the model-backed root-cause narrative on a breach."
        type: boolean
        required: false
        default: false

concurrency:
  # Serialize a manual dispatch overlapping the cron — the issue create/comment
  # path is not atomic. Do not cancel: let an in-flight post finish.
  group: cost-monitor-${{ github.workflow }}
  cancel-in-progress: false

# All writes go through BOT_TOKEN; the default GITHUB_TOKEN only reads the
# checkout, so an `issues: write` grant here would be dead weight.
permissions:
  contents: read

jobs:
  monitor:
    name: Monitor review cost
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      # Full history so the attribution step can diff the review process
      # between the baseline window and now.
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - uses: awinogradov/code-assistants/.github/actions/code-review-cost-monitor@main
        with:
          bot_token: ${{ secrets.BOT_TOKEN }}
          anthropic_api_key: ${{ secrets.ANTHROPIC_CODE_REVIEW }}
          lookback_days: ${{ inputs.lookback_days }}
          attribution: ${{ inputs.attribution }}
</file>

<file path=".github/workflows/code-review.yml">
# Source: https://github.com/awinogradov/code-assistants/blob/main/.github/workflows/code-review.yml
# This file is distributed to downstream repositories by an automated sync.
# Edits made downstream are overwritten on the next run.
# To change it, open a pull request against the source file above.
#
# Repository variables consumed by this workflow:
#   - `BOT_USERNAME` (required): GitHub login of the AI reviewer bot. Without this the
#     `ai-review` job is skipped entirely.
#   - `RELEASE_PR_AUTHORS` (optional): comma-separated list of trusted authors whose
#     `release-*` / `delivery-*` branch PRs get an auto-approval after AI review is
#     skipped. Leave unset to keep the previous skip-only behaviour. Set this only
#     for identities you trust to open release PRs (e.g. `github-actions[bot]`).

name: AI Code Review

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review, edited]
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

concurrency:
  # comment.id gives each comment its own group so bursty replies aren't cancelled;
  # it's empty for pull_request events, which stay grouped per-PR (event_name + number).
  group: code-review-${{ github.event_name }}-${{ github.event.pull_request.number || github.event.issue.number }}-${{ github.event.comment.id }}
  # Cancel superseded runs so only the latest push/comment is reviewed. The action
  # no longer edits the PR body, so no bot self-edit can abort an in-flight review.
  cancel-in-progress: true

jobs:
  ai-review:
    # The bot's own events (its review and inline comments) are skipped here so they
    # don't spawn a no-op react run — the in-action guard would skip them only after a
    # runner spins up, so filtering at the job `if:` is cheaper.
    #
    # The last clause re-runs review when a user edits a PR title/body, so a
    # description fix clears a stale CHANGES_REQUESTED verdict without the prior
    # close/reopen workaround (introduced de-facto by #233's alignment checks).
    # Base retargets (changes.base) are skipped — a later push re-covers them.
    if: >-
      (github.event_name != 'issue_comment' || github.event.issue.pull_request)
      && vars.BOT_USERNAME != ''
      && github.event.sender.login != vars.BOT_USERNAME
      && (github.event.action != 'edited' || github.event.changes.title || github.event.changes.body)
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: awinogradov/code-assistants/.github/actions/code-review-action@main
        with:
          reviewer: ${{ vars.BOT_USERNAME }}
          bot_token: ${{ secrets.BOT_TOKEN }}
          anthropic_api_key: ${{ secrets.ANTHROPIC_CODE_REVIEW }}
          release_pr_authors: ${{ vars.RELEASE_PR_AUTHORS }}
</file>

