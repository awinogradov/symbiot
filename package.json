{
  "name": "symbiot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.9",
  "agents": {
    "rules": "Bun+React+Tailwind",
    "language": "typescript"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prettier": "@symbiot/prettier-config",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:story": ": \"${STORY:?set STORY to a tag expression, e.g. STORY=@UC4}\" && bddgen --tags \"$STORY\" && playwright test",
    "test:e2e:coverage": "rm -rf coverage/e2e coverage/raw && COVERAGE=1 bddgen && COVERAGE=1 playwright test && node --experimental-strip-types mcr-generate.ts",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "licenses:audit": "bun run scripts/licenses-report.ts",
    "perf": "bun run scripts/perf-lighthouse.ts",
    "hook:install": "bun --filter @symbiot/claude-code install-hook",
    "hook:uninstall": "bun --filter @symbiot/claude-code uninstall-hook",
    "viewer:smoke": "bun --filter @symbiot/viewer smoke",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "bun run --filter ./packages/eslint-config --filter ./packages/prettier-config build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@playwright/test": "1.60.0",
    "@symbiot/eslint-config": "workspace:*",
    "@symbiot/prettier-config": "workspace:*",
    "@symbiot/typescript-config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "4.1.6",
    "chrome-launcher": "1.2.1",
    "eslint": "10.4.0",
    "eslint-plugin-playwright": "2.10.4",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "license-checker-rseidelsohn": "4.4.2",
    "lighthouse": "13.3.0",
    "lint-staged": "17.0.5",
    "monocart-coverage-reports": "2.12.11",
    "playwright-bdd": "8.5.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
